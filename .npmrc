# Sécurisation de la chaîne d'approvisionnement npm.
#
# ignore-scripts  : neutralise les scripts preinstall et postinstall des
#                   dépendances, vecteur d'entrée de la quasi-totalité des
#                   vers npm récents. Ce projet n'a aucun script de cycle
#                   de vie propre, l'activation est donc sans effet de bord.
# min-release-age : n'installe que des versions publiées depuis plus de
#                   3 jours. Les paquets compromis sont presque toujours
#                   dépubliés en quelques heures.
#
# Ce fichier est versionné à dessein : sur un runner d'intégration continue
# le ~/.npmrc du poste n'existe pas, et seule cette configuration de dépôt
# s'applique.
ignore-scripts=true
min-release-age=3
